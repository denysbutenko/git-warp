[package]
name = "git-warp"
version = "0.3.0"
edition = "2024"
authors = ["Git-Warp Contributors"]
description = "High-performance, UX-focused Git worktree manager combining CoW speed with advanced features"
license = "MIT"
repository = "https://github.com/denysbutenko/git-warp"
readme = "README.md"

[[bin]]
name = "warp"
path = "src/main.rs"

[dependencies]
# CLI & TUI
clap = { version = "4.6.1", features = ["derive", "env"] }
ratatui = "0.29.0"
crossterm = "0.28.1"

# Core Logic
nix = { version = "0.29.0", features = ["fs", "signal"] }
rayon = "1.10.0"
ignore = "0.4.22"
sysinfo = "0.32.0"

# Configuration & Data
figment = { version = "0.10.19", features = ["toml", "env"] }
serde = { version = "1.0.228", features = ["derive"] }
serde_json = "1.0.150"
toml = "0.8.23"

# Utilities
anyhow = "1.0.102"
thiserror = "2.0.18"
log = "0.4.30"
env_logger = "0.11.10"
dirs = "6.0.0"
chrono = "0.4.44"

[dev-dependencies]
tempfile = "3.10.1"
criterion = "0.5"
rand = "0.8"

[[bench]]
name = "performance_benchmarks"
harness = false
